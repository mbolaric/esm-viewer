{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Default permissions for ESM Viewer desktop shell",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "core:window:allow-set-theme",
        "dialog:default",
        "dialog:allow-open",
        "dialog:allow-save",
        "fs:default",
        {
            "identifier": "fs:allow-read-file",
            "allow": [{ "path": "**" }]
        },
        {
            "identifier": "fs:allow-write-file",
            "allow": [{ "path": "**" }]
        },
        {
            "identifier": "fs:allow-rename",
            "allow": [{ "path": "**" }]
        },
        {
            "identifier": "fs:allow-stat",
            "allow": [{ "path": "**" }]
        },
        {
            "identifier": "fs:allow-remove",
            "allow": [{ "path": "**" }]
        }
    ]
}
