{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ESM Viewer",
    "version": "0.1.0",
    "identifier": "com.esmviewer.desktop",
    "build": {
        "beforeDevCommand": "pnpm dev:tauri:renderer",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build:tauri:renderer",
        "frontendDist": "../apps/viewer/dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "ESM Viewer",
                "width": 1440,
                "height": 900,
                "minWidth": 640,
                "minHeight": 480,
                "resizable": true,
                "fullscreen": false,
                "devtools": false,
                "create": false,
                "useHttpsScheme": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' ipc://localhost http://ipc.localhost https://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/AppIcon.icon",
            "icons/icon.ico",
            "icons/icon.png"
        ],
        "macOS": {
            "signingIdentity": "-"
        }
    }
}
