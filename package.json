{
    "name": "esm-viewer",
    "productName": "ESM Viewer",
    "version": "0.1.0",
    "private": true,
    "description": "A local-first desktop viewer for digital tachograph files.",
    "homepage": "https://github.com/mbolaric/esm-viewer",
    "author": "Milan Bolaric",
    "license": "GPL-3.0-only",
    "type": "module",
    "imports": {
        "#application-i18n": "./src/localization/application-catalogue.ts",
        "#contracts": "./src/contracts/index.ts",
        "#compliance": "./src/compliance/index.ts",
        "#compliance-rules": "./src/compliance/rules.ts",
        "#compliance-feature": "./src/compliance/feature/index.ts",
        "#compliance-export-controller": "./src/compliance/feature/controllers/compliance-export-controller.svelte.ts",
        "#compliance-profile-controller": "./src/compliance/feature/controllers/compliance-profile-controller.svelte.ts",
        "#tauri-platform": "./src/platform/tauri/index.ts",
        "#tachograph-domain": "./src/tachograph-domain/index.ts",
        "#time": "./src/time/index.ts",
        "#error-reporting": "./src/error-reporting/index.ts",
        "#localization": "./src/localization/index.ts",
        "#testing": "./src/__tests__/index.ts",
        "#ui": "./src/ui/index.ts",
        "#shell": "./src/shell/index.ts",
        "#ui/styles/foundation.css": "./src/ui/styles/foundation.css",
        "#viewer": "./src/viewer/feature/index.ts",
        "#viewer-context": "./src/viewer/feature/viewer-context.ts",
        "#viewer-application": "./src/viewer/application/index.ts",
        "#viewer-domain": "./src/viewer/domain/index.ts",
        "#i18n": "./src/localization/catalogues/en.ts",
        "#i18n-locales": "./src/localization/catalogues/index.ts",
        "#viewer-parser-client": "./src/viewer/parser/client.ts",
        "#viewer-presentation": "./src/viewer/presentation/index.ts"
    },
    "packageManager": "pnpm@11.17.0",
    "engines": {
        "node": "^24.0.0 || >=26.0.0",
        "pnpm": "11.17.0"
    },
    "scripts": {
        "architecture": "depcruise --config dependency-cruiser.config.mjs apps src tools && pnpm dependencies:check",
        "build": "pnpm clean && pnpm build:tauri:renderer",
        "build:tauri:renderer": "vite build --config apps/viewer/vite.config.ts",
        "check": "pnpm check:types && pnpm check:svelte && pnpm check:rust",
        "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
        "check:svelte": "svelte-check --config svelte.config.js --tsconfig tsconfig.renderer.json --fail-on-warnings",
        "check:types": "pnpm check:types:node && pnpm check:types:renderer && pnpm check:types:tests",
        "check:types:node": "tsc --noEmit --project tsconfig.node.json",
        "check:types:renderer": "tsc --noEmit --project tsconfig.renderer.json",
        "check:types:tests": "tsc --noEmit --project tsconfig.tests.json",
        "clean": "node --experimental-strip-types tools/clean.ts",
        "dev:tauri:renderer": "vite --config apps/viewer/vite.config.ts --port 1420 --strictPort",
        "dependencies:check": "node --experimental-strip-types tools/dependencies/check-lockfile.ts",
        "duplication": "jscpd --config jscpd.json --fail-on-empty",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "i18n:check": "vitest run tools/i18n/__tests__/catalogue.test.ts --project node",
        "lint": "node --experimental-strip-types tools/quality/check-test-layout.ts && node --experimental-strip-types tools/quality/check-design-values.ts && eslint . --max-warnings 0",
        "parser:sync-types": "node --experimental-strip-types tools/sync-parser-types.ts",
        "quality": "pnpm format:check && pnpm lint && pnpm i18n:check && pnpm check && pnpm test && pnpm architecture && pnpm duplication && pnpm build",
        "test": "vitest run && pnpm test:rust",
        "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
        "tauri:build": "tauri build",
        "tauri:build:debug": "tauri build --debug --features devtools",
        "tauri:dev": "tauri dev --features devtools"
    },
    "dependencies": {
        "@lucide/svelte": "1.50.0",
        "@tauri-apps/api": "2.12.1",
        "@tauri-apps/plugin-dialog": "2.8.1",
        "@tauri-apps/plugin-fs": "2.6.0",
        "echarts": "6.1.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@tauri-apps/cli": "2.12.1",
        "@testing-library/svelte": "5.4.2",
        "@types/node": "26.6.4",
        "@vitest/coverage-v8": "5.0.3",
        "axe-core": "4.13.0",
        "dependency-cruiser": "18.5.0",
        "eslint": "10.11.0",
        "eslint-plugin-svelte": "3.23.0",
        "globals": "17.13.0",
        "jscpd": "5.4.0",
        "jsdom": "30.1.1",
        "prettier": "3.9.9",
        "prettier-plugin-svelte": "4.1.1",
        "svelte": "5.57.1",
        "svelte-check": "4.7.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.2",
        "vitest": "5.0.3"
    }
}
